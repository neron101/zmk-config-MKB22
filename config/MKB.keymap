// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define DEF 0
#define FUNC 1
#define NUM 2
#define MOUSE 3
#define SCROLL 4
#define BT 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        // ロータリーエンコーダー（DYA Studioから変更可。以下は初期値）
        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_pg: rsr_pg {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp PG_DN>;
            ccw-binding = <&kp PG_UP>;
        };
        rsr_lr: rsr_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT>;
            ccw-binding = <&kp LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp TAB       &kp Q           &kp W         &kp E    &kp R        &kp T         &kp Y           &kp U          &kp I         &kp O      &kp P         &kp MINUS
&kp CAPSLOCK  &kp A           &kp S         &kp D    &kp F        &kp G         &kp H           &kp J          &kp K         &kp L      &kp RS(SEMI)  &lt MOUSE EQUAL
&kp LSHFT     &kp Z           &kp X         &kp C    &kp V        &kp B         &kp N           &kp M          &kp COMMA     &kp DOT    &kp UP        &kp RS(FSLH)
&mkp MB2      &lt 5 LEFT_ALT  &kp LEFT_GUI           &lt 1 SPACE  &mkp MB1      &lt NUM ENTER  &kp BACKSPACE                &kp LEFT   &kp DOWN      &kp RIGHT
&kp LEFT      &kp C_AC_HOME   &kp SPACE     &kp END  &kp RIGHT                                  &kp LEFT       &kp UP_ARROW  &kp ENTER  &kp DOWN      &kp RIGHT
                                            &kp A                                                              &kp B
            >;

            sensor-bindings = <&rsr_scrl>, <&rsr_vol>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&trans          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp NUMBER_4  &kp N5              &kp NUMBER_6  &kp N7     &kp N8     &kp N9     &kp N0     &trans
&kp LANGUAGE_1  &kp LEFT      &kp UP_ARROW  &kp RIGHT        &trans        &kp LANGUAGE_1      &trans        &trans     &trans     &trans     &trans     &trans
&kp LANGUAGE_2  &kp LEFT      &kp DOWN      &kp RIGHT_ARROW  &trans        &kp LANGUAGE_2      &trans        &trans     &trans     &trans     &trans     &trans
&trans          &trans        &kp LALT                       &kp ENTER     &kp ENTER           &kp ENTER     &kp ENTER             &trans     &trans     &trans
&kp LEFT        &kp UP        &kp SPACE     &kp DOWN         &kp RIGHT                                       &kp HOME   &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                            &kp A                                                                       &kp B
            >;

            sensor-bindings = <&rsr_lr>, <&rsr_pg>;
        };

        num_layer {
            label = "Num";
            bindings = <
&kp CAPS        &kp LS(N1)  &kp LS(N2)      &kp LS(N3)  &kp LS(N4)  &kp LS(N5)          &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &trans     &kp N0     &trans
&kp LANGUAGE_1  &kp LEFT    &kp UP_ARROW    &kp RIGHT   &trans      &kp LANGUAGE_1      &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT   &trans     &trans
&kp LANGUAGE_2  &kp LEFT    &kp DOWN_ARROW  &kp RIGHT   &trans      &kp LANGUAGE_2      &trans      &trans      &kp SEMI    &kp SQT    &trans     &kp SLASH
&trans          &trans      &trans                      &trans      &trans              &trans      &trans                  &trans     &trans     &trans
&kp LEFT        &kp UP      &kp SPACE       &kp DOWN    &kp RIGHT                                   &kp HOME    &kp PG_UP   &kp ENTER  &kp PG_DN  &kp END
                                            &kp A                                                               &kp B
            >;

            sensor-bindings = <&rsr_scrl>, <&rsr_vol>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &mkp MB1  &mkp MB3   &mkp MB2   &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings = <&rsr_scrl>, <&rsr_vol>;
        };

        scroll_layer {
            label = "Scr";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &mkp MB1  &mkp MB3   &mkp MB2   &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings = <&rsr_scrl>, <&rsr_vol>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &bt BT_CLR_ALL  &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans                      &trans        &trans            &trans          &trans               &trans     &trans     &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                                       &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                                   &kp B
            >;

            sensor-bindings = <&rsr_scrl>, <&rsr_vol>;
        };
    };
};
